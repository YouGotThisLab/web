{
  "name": "youchuxi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests index.html package.json tsconfig.json",
    "format:check": "prettier --check src tests index.html package.json tsconfig.json",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "check:worker": "tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.147.0"
  }
}
